<!DOCTYPE html>
<html lang="es">
  <head>
    <title>RetailERP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-stone-50 flex h-screen overflow-hidden font-sans antialiased">

    <%# ── Sidebar ─────────────────────────────────────────────── %>
    <aside class="w-64 shrink-0 hidden md:flex flex-col" style="background: #0f1f14;">

      <%# Logo %>
      <div class="px-6 py-5 flex items-center gap-3 border-b border-white/5">
        <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <span class="text-white font-bold text-lg tracking-tight">RetailERP</span>
      </div>

      <%# Navigation %>
      <nav class="flex-1 px-3 py-5 space-y-1 overflow-y-auto">
        <p class="px-3 mb-2 text-xs font-semibold text-stone-500 uppercase tracking-widest">Principal</p>

        <%= link_to root_path,
              class: "group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-150
                      #{request.path == '/' ? 'bg-emerald-500/20 text-emerald-300' : 'text-stone-400 hover:bg-white/5 hover:text-stone-200'}" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Dashboard
        <% end %>

        <p class="px-3 pt-4 mb-2 text-xs font-semibold text-stone-500 uppercase tracking-widest">Gestión</p>

        <%= link_to sales_path,
              class: "group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-150
                      #{request.path.start_with?('/sales') ? 'bg-emerald-500/20 text-emerald-300' : 'text-stone-400 hover:bg-white/5 hover:text-stone-200'}" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          Ventas
        <% end %>

        <%= link_to customers_path,
              class: "group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-150
                      #{request.path.start_with?('/customers') ? 'bg-emerald-500/20 text-emerald-300' : 'text-stone-400 hover:bg-white/5 hover:text-stone-200'}" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Clientes
        <% end %>

        <%= link_to products_path,
              class: "group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-150
                      #{request.path.start_with?('/products') ? 'bg-emerald-500/20 text-emerald-300' : 'text-stone-400 hover:bg-white/5 hover:text-stone-200'}" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
          Inventario
        <% end %>
      </nav>

      <%# User / Logout %>
      <div class="px-4 py-4 border-t border-white/5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xs font-bold shrink-0">
            <%= current_user.email[0].upcase %>
          </div>
          <div class="min-w-0">
            <p class="text-xs font-medium text-stone-300 truncate"><%= current_user.email %></p>
            <p class="text-xs text-stone-600">Administrador</p>
          </div>
        </div>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-stone-500 hover:bg-white/5 hover:text-rose-400 transition-all duration-150" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Cerrar sesión
        <% end %>
      </div>
    </aside>

    <%# ── Main area ──────────────────────────────────────────── %>
    <div class="flex-1 flex flex-col overflow-hidden">

      <%# Top header %>
      <header class="bg-white border-b border-stone-100 h-14 flex items-center justify-between px-6 shrink-0">
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-semibold text-stone-700">
            <%= content_for?(:page_title) ? yield(:page_title) : "Panel de Control" %>
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs text-stone-400"><%= Time.now.strftime("%d %b %Y") %></span>
          <div class="w-7 h-7 rounded-full bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-700 text-xs font-bold">
            <%= current_user.email[0].upcase %>
          </div>
        </div>
      </header>

      <%# Content %>
      <main class="flex-1 overflow-y-auto p-6">
        <%= yield %>
      </main>
    </div>

  </body>
</html>
