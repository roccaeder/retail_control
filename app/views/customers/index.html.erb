<% content_for :page_title, "Clientes" %>

<div class="space-y-5 max-w-7xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Clientes</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @customers.count %> clientes registrados</p>
    </div>
    <%= link_to new_customer_path, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
      </svg>
      Nuevo Cliente
    <% end %>
  </div>

  <%# ── KPI mini-cards ─────────────────────────────────────── %>
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Total Clientes</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-800"><%= Customer.count %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Con Deuda</p>
      <p class="mt-1.5 text-2xl font-bold text-amber-600"><%= Customer.where("current_debt > 0").count %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Deuda Total</p>
      <p class="mt-1.5 text-2xl font-bold text-rose-600">$<%= number_with_precision(Customer.sum(:current_debt), precision: 2, delimiter: ",") %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Al Corriente</p>
      <p class="mt-1.5 text-2xl font-bold text-emerald-600"><%= Customer.where(current_debt: 0).count %></p>
    </div>
  </div>

  <%# ── Table ──────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50">
      <h3 class="text-sm font-bold text-stone-700">Directorio de Clientes</h3>
    </div>

    <% if @customers.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Teléfono</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Deuda Actual</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Límite Crédito</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Alta</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @customers.each do |customer| %>
            <% debt_pct = customer.debt_limit > 0 ? (customer.current_debt / customer.debt_limit * 100).round : 0 %>
            <tr class="hover:bg-stone-50/60 transition-colors group">
              <td class="px-6 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-700 text-xs font-bold shrink-0">
                    <%= customer.name[0].upcase %>
                  </div>
                  <span class="text-sm font-semibold text-stone-700"><%= customer.name %></span>
                </div>
              </td>
              <td class="px-6 py-3.5 text-sm text-stone-500"><%= customer.phone.presence || "—" %></td>
              <td class="px-6 py-3.5 text-right text-sm font-semibold <%= customer.current_debt > 0 ? 'text-rose-600' : 'text-stone-400' %>">
                $<%= number_with_precision(customer.current_debt, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-right text-sm text-stone-500">
                $<%= number_with_precision(customer.debt_limit, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-center">
                <% if customer.current_debt == 0 %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Al corriente
                  </span>
                <% elsif debt_pct >= 90 %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Límite alto
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Con fiado
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-xs text-stone-400">
                <%= customer.created_at.strftime("%d/%m/%Y") %>
              </td>
              <td class="px-6 py-3.5 text-right">
                <% unless customer.generic? %>
                  <div class="flex items-center justify-end gap-3">
                    <%= link_to edit_customer_path(customer), class: "text-xs font-semibold text-stone-400 hover:text-emerald-600 transition-colors" do %>
                      Editar
                    <% end %>
                    <%= button_to customer_path(customer), method: :delete,
                          data: { turbo_confirm: "¿Eliminar a #{customer.name}? Esta acción no se puede deshacer." },
                          class: "text-xs font-semibold text-stone-400 hover:text-rose-600 transition-colors bg-transparent border-0 cursor-pointer p-0" do %>
                      Eliminar
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-20 text-center">
        <div class="w-14 h-14 bg-stone-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <p class="text-sm font-semibold text-stone-500">No hay clientes registrados</p>
        <p class="text-xs text-stone-400 mt-1">Agrega tu primer cliente para comenzar</p>
        <%= link_to "Agregar cliente", new_customer_path, class: "mt-4 inline-flex items-center gap-1.5 text-sm text-emerald-600 hover:text-emerald-700 font-semibold" %>
      </div>
    <% end %>
  </div>

</div>
