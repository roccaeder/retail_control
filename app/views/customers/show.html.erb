<% content_for :page_title, @customer.name %>

<% debt_pct = @customer.debt_limit > 0 ? (@customer.current_debt / @customer.debt_limit * 100).round : 0 %>

<div class="space-y-5 max-w-3xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-700 text-sm font-bold shrink-0">
        <%= @customer.name[0].upcase %>
      </div>
      <div>
        <h1 class="text-xl font-bold text-stone-800"><%= @customer.name %></h1>
        <p class="text-sm text-stone-400 mt-0.5"><%= @customer.phone.presence || "Sin teléfono" %></p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to edit_customer_path(@customer),
            class: "inline-flex items-center gap-2 bg-white hover:bg-stone-50 border border-stone-200 text-stone-700 text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Editar
      <% end %>
      <%= link_to customers_path, class: "text-sm text-stone-500 hover:text-stone-700 font-semibold px-2 py-2 transition-colors" do %>
        ← Volver
      <% end %>
    </div>
  </div>

  <%# ── KPI cards ───────────────────────────────────────────── %>
  <div class="grid grid-cols-2 xl:grid-cols-3 gap-4">
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Deuda actual</p>
      <p class="mt-1.5 text-2xl font-bold <%= @customer.current_debt > 0 ? 'text-rose-600' : 'text-stone-400' %>">
        $<%= number_with_precision(@customer.current_debt, precision: 2, delimiter: ",") %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Límite de crédito</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-800">
        $<%= number_with_precision(@customer.debt_limit, precision: 2, delimiter: ",") %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm col-span-2 xl:col-span-1">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</p>
      <div class="mt-2">
        <% if @customer.current_debt == 0 %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-semibold bg-emerald-50 text-emerald-700">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Al corriente
          </span>
        <% elsif debt_pct >= 90 %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-semibold bg-rose-50 text-rose-700">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span> Límite alto (<%= debt_pct %>%)
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-semibold bg-amber-50 text-amber-700">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span> Con fiado (<%= debt_pct %>%)
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Últimas ventas ──────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50 flex items-center justify-between">
      <h3 class="text-sm font-bold text-stone-700">Últimas ventas</h3>
      <span class="text-xs text-stone-400"><%= @customer.sales.count %> en total</span>
    </div>
    <% if @sales.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Código</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Fecha</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @sales.each do |sale| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3 text-sm font-mono text-stone-600"><%= sale.code.presence || "—" %></td>
              <td class="px-6 py-3 text-sm text-stone-500"><%= sale.sale_date&.strftime("%d/%m/%Y") %></td>
              <td class="px-6 py-3 text-right text-sm font-semibold text-stone-800">
                $<%= number_with_precision(sale.total, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3 text-center">
                <% case sale.status %>
                <% when "paid" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">Pagado</span>
                <% when "partial" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">Parcial</span>
                <% when "pending" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">Pendiente</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-6 py-8 text-sm text-stone-400 text-center">Este cliente no tiene ventas registradas.</p>
    <% end %>
  </div>

</div>
