<% content_for :page_title, "Dashboard" %>

<div class="space-y-6 max-w-7xl mx-auto">

  <%# ── Header row ──────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Resumen del Negocio</h1>
      <p class="text-sm text-stone-400 mt-0.5">Vista general de tu operación</p>
    </div>
    <span class="text-xs bg-stone-100 text-stone-500 px-3 py-1.5 rounded-full font-medium">
      <%= Time.now.strftime("%A, %d de %B %Y").capitalize %>
    </span>
  </div>

  <%# ── KPI Cards ────────────────────────────────────────────── %>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

    <%# Ventas totales %>
    <div class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Ventas Totales</p>
          <p class="mt-2 text-2xl font-bold text-stone-800">
            $<%= number_with_precision(Sale.sum(:total), precision: 2, delimiter: ",") %>
          </p>
        </div>
        <div class="p-2.5 bg-emerald-50 rounded-xl">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-center gap-1 text-xs text-stone-400">
        <span class="text-emerald-500 font-semibold"><%= Sale.count %></span> ventas registradas
      </div>
    </div>

    <%# Ventas del día %>
    <div class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Ventas Hoy</p>
          <p class="mt-2 text-2xl font-bold text-stone-800">
            $<%= number_with_precision(Sale.where(created_at: Time.zone.today.all_day).sum(:total), precision: 2, delimiter: ",") %>
          </p>
        </div>
        <div class="p-2.5 bg-teal-50 rounded-xl">
          <svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-center gap-1 text-xs text-stone-400">
        <span class="text-teal-500 font-semibold"><%= Sale.where(created_at: Time.zone.today.all_day).count %></span> transacciones hoy
      </div>
    </div>

    <%# Cartera de fiados %>
    <div class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Cartera Fiados</p>
          <p class="mt-2 text-2xl font-bold text-stone-800">
            $<%= number_with_precision(Customer.sum(:current_debt), precision: 2, delimiter: ",") %>
          </p>
        </div>
        <div class="p-2.5 bg-amber-50 rounded-xl">
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-center gap-1 text-xs text-stone-400">
        <span class="text-amber-500 font-semibold"><%= Customer.where("current_debt > 0").count %></span> clientes con deuda
      </div>
    </div>

    <%# Stock bajo %>
    <div class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Stock Bajo</p>
          <p class="mt-2 text-2xl font-bold text-stone-800">
            <%= Product.where("stock < ?", 10).count %> ítems
          </p>
        </div>
        <div class="p-2.5 bg-rose-50 rounded-xl">
          <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-center gap-1 text-xs text-stone-400">
        <span class="text-rose-500 font-semibold"><%= Product.count %></span> productos en total
      </div>
    </div>
  </div>

  <%# ── Quick-access shortcuts ────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-3">
    <%= link_to sales_path, class: "bg-white border border-stone-100 rounded-2xl p-4 flex items-center gap-3 hover:border-emerald-200 hover:shadow-md transition-all group" do %>
      <div class="p-2 bg-emerald-50 rounded-xl group-hover:bg-emerald-100 transition-colors">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold text-stone-700">Ventas</p>
        <p class="text-xs text-stone-400"><%= Sale.count %> registros</p>
      </div>
    <% end %>

    <%= link_to customers_path, class: "bg-white border border-stone-100 rounded-2xl p-4 flex items-center gap-3 hover:border-teal-200 hover:shadow-md transition-all group" do %>
      <div class="p-2 bg-teal-50 rounded-xl group-hover:bg-teal-100 transition-colors">
        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold text-stone-700">Clientes</p>
        <p class="text-xs text-stone-400"><%= Customer.count %> registrados</p>
      </div>
    <% end %>

    <%= link_to products_path, class: "bg-white border border-stone-100 rounded-2xl p-4 flex items-center gap-3 hover:border-violet-200 hover:shadow-md transition-all group" do %>
      <div class="p-2 bg-violet-50 rounded-xl group-hover:bg-violet-100 transition-colors">
        <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold text-stone-700">Inventario</p>
        <p class="text-xs text-stone-400"><%= Product.count %> productos</p>
      </div>
    <% end %>
  </div>

  <%# ── Last sales table ─────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50 flex items-center justify-between">
      <h3 class="text-sm font-bold text-stone-700">Últimas Transacciones</h3>
      <%= link_to "Ver todas", sales_path, class: "text-xs text-emerald-600 hover:text-emerald-700 font-medium" %>
    </div>

    <% recent_sales = Sale.includes(:customer).order(created_at: :desc).limit(8) %>
    <% if recent_sales.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Método</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Fecha</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% recent_sales.each do |sale| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3.5">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 text-xs font-bold">
                    <%= sale.customer.name[0].upcase %>
                  </div>
                  <span class="text-sm font-medium text-stone-700"><%= sale.customer.name %></span>
                </div>
              </td>
              <td class="px-6 py-3.5 text-sm font-semibold text-stone-800">
                $<%= number_with_precision(sale.total, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5">
                <span class="text-xs text-stone-500">
                  <% if sale.payment_method == "cash" %>Efectivo
                  <% elsif sale.payment_method == "credit" %>Fiado
                  <% elsif sale.payment_method == "transfer" %>Transferencia
                  <% end %>
                </span>
              </td>
              <td class="px-6 py-3.5">
                <% if sale.paid? %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Pagado
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pendiente
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-xs text-stone-400">
                <%= sale.created_at.strftime("%d/%m/%Y %H:%M") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-16 text-center">
        <svg class="w-10 h-10 text-stone-200 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p class="text-sm text-stone-400">No hay transacciones aún</p>
      </div>
    <% end %>
  </div>

</div>
