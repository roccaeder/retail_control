<%= turbo_frame_tag "modal" do %>
  <dialog data-controller="modal"
          class="w-[22rem] rounded-2xl border border-stone-200 shadow-xl p-0 m-auto"
          style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);">

    <style>
      dialog[open]::backdrop { background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px); }
    </style>

    <%# ── Header ───────────────────────────────────── %>
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-stone-100">
      <div>
        <h2 class="text-sm font-bold text-stone-800">Registrar pago</h2>
        <p class="text-xs text-stone-400 mt-0.5"><%= @sale.code %> · <%= @sale.customer.name %></p>
      </div>
      <button type="button" data-action="modal#close"
              class="w-7 h-7 rounded-lg flex items-center justify-center text-stone-400 hover:bg-stone-100 hover:text-stone-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# ── Sale summary ─────────────────────────────── %>
    <div class="px-5 py-3 bg-stone-50/80 border-b border-stone-100 grid grid-cols-2 gap-2">
      <div>
        <p class="text-xs text-stone-400">Total venta</p>
        <p class="text-base font-bold text-stone-700 mt-0.5">
          $<%= number_with_precision(@sale.total, precision: 2, delimiter: ",") %>
        </p>
      </div>
      <div>
        <p class="text-xs text-stone-400">Saldo pendiente</p>
        <p class="text-base font-bold text-rose-600 mt-0.5">
          $<%= number_with_precision(@sale.balance_due, precision: 2, delimiter: ",") %>
        </p>
      </div>
    </div>

    <%# ── Errors ───────────────────────────────────── %>
    <% if @errors&.any? %>
      <div class="mx-5 mt-3 px-3 py-2.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700">
        <% @errors.each do |error| %>
          <p><%= error %></p>
        <% end %>
      </div>
    <% end %>

    <%# ── Form ────────────────────────────────────── %>
    <%= form_with model: [@sale, @payment], url: sale_payments_path(@sale), class: "px-5 py-4 space-y-3" do |f| %>

      <div>
        <%= f.label :amount, "Monto a pagar", class: "block text-xs font-semibold text-stone-600 mb-1.5" %>
        <div class="flex rounded-xl border border-stone-200 focus-within:ring-2 focus-within:ring-emerald-500 focus-within:border-transparent bg-white overflow-hidden">
          <span class="px-3 flex items-center text-stone-400 text-sm bg-stone-50 border-r border-stone-200">$</span>
          <%= f.number_field :amount,
                value: number_with_precision(@sale.balance_due, precision: 2),
                step: "0.01", min: "0.01",
                class: "flex-1 px-3 py-2 text-sm text-stone-800 focus:outline-none",
                placeholder: "0.00" %>
        </div>
      </div>

      <div>
        <%= f.label :payment_method, "Método de pago", class: "block text-xs font-semibold text-stone-600 mb-1.5" %>
        <%= f.select :payment_method,
              [["Efectivo", "cash"], ["Transferencia", "transfer"]],
              {},
              class: "w-full px-3 py-2 rounded-xl border border-stone-200 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent bg-white" %>
      </div>

      <div class="flex gap-2 pt-1">
        <button type="button" data-action="modal#close"
                class="flex-1 px-3 py-2 rounded-xl border border-stone-200 text-sm font-semibold text-stone-500 hover:bg-stone-50 transition-colors">
          Cancelar
        </button>
        <%= f.submit "Confirmar pago",
              class: "flex-1 px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-colors cursor-pointer" %>
      </div>

    <% end %>

  </dialog>
<% end %>
