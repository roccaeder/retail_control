<% content_for :page_title, "Nueva Compra" %>

<div class="max-w-3xl mx-auto space-y-5">

  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-stone-800">Nueva Orden de Compra</h1>
    <%= link_to "← Volver", purchases_path, class: "text-sm text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
  </div>

  <%= form_with model: @purchase, data: { controller: "purchase-form" } do |f| %>
    <% if @purchase.errors.any? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm space-y-1">
        <% @purchase.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-4">
      <h3 class="text-sm font-bold text-stone-700">Información General</h3>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Proveedor *</label>
          <%= f.select :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, @purchase.supplier_id),
                { include_blank: "Seleccionar…" },
                class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">N° Factura</label>
          <%= f.text_field :invoice_number, class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400", placeholder: "Opcional" %>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-stone-50 flex items-center justify-between">
        <h3 class="text-sm font-bold text-stone-700">Productos</h3>
        <button type="button" data-action="click->purchase-form#addRow"
                class="inline-flex items-center gap-1.5 text-xs text-emerald-600 hover:text-emerald-700 font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          Agregar producto
        </button>
      </div>

      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-4 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Producto</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Cantidad</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Costo unitario</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Subtotal</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody data-purchase-form-target="itemsContainer">
          <%= f.fields_for :purchase_items do |pf| %>
            <%= render "purchase_item_row", pf: pf, products: @products %>
          <% end %>
        </tbody>
      </table>

      <div class="px-6 py-3 border-t border-stone-50 flex justify-end">
        <p class="text-sm text-stone-500">
          Total estimado: <span class="font-bold text-stone-800" data-purchase-form-target="total">$0.00</span>
        </p>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancelar", purchases_path, class: "px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-stone-800 transition-colors", data: { turbo_frame: "_top" } %>
      <%= f.submit "Guardar borrador", class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer" %>
    </div>
  <% end %>

</div>

<template id="purchase-item-template">
  <tr data-purchase-form-target="row">
    <td class="px-4 py-2.5">
      <select name="purchase[purchase_items_attributes][REPLACE_INDEX][product_id]"
              data-action="change->purchase-form#recalculate"
              class="w-full rounded-lg border border-stone-200 px-2.5 py-1.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400">
        <option value="">Seleccionar…</option>
        <% @products.each do |p| %>
          <option value="<%= p.id %>"><%= p.name %></option>
        <% end %>
      </select>
    </td>
    <td class="px-4 py-2.5">
      <input type="number" name="purchase[purchase_items_attributes][REPLACE_INDEX][quantity]"
             min="1" value="1"
             data-action="input->purchase-form#recalculate"
             data-purchase-form-target="quantity"
             class="w-20 rounded-lg border border-stone-200 px-2.5 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-emerald-400">
    </td>
    <td class="px-4 py-2.5">
      <input type="number" name="purchase[purchase_items_attributes][REPLACE_INDEX][unit_cost]"
             min="0" step="0.01" value="0.00"
             data-action="input->purchase-form#recalculate"
             data-purchase-form-target="unitCost"
             class="w-28 rounded-lg border border-stone-200 px-2.5 py-1.5 text-sm text-right focus:outline-none focus:ring-2 focus:ring-emerald-400">
    </td>
    <td class="px-4 py-2.5 text-right text-sm font-semibold text-stone-700 w-24" data-purchase-form-target="rowSubtotal">$0.00</td>
    <td class="px-4 py-2.5 text-center">
      <button type="button" data-action="click->purchase-form#removeRow"
              class="text-rose-400 hover:text-rose-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </td>
  </tr>
</template>
