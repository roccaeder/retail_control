<% content_for :page_title, "Compras" %>

<div class="space-y-5 max-w-7xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Compras</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @purchases.count %> órdenes registradas</p>
    </div>
    <%= link_to new_purchase_path, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
      </svg>
      Nueva Compra
    <% end %>
  </div>

  <%# ── Tabla ──────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <% if @purchases.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-100">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Proveedor</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Factura</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Fecha</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @purchases.each do |purchase| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3.5 text-sm font-medium text-stone-700"><%= purchase.supplier.name %></td>
              <td class="px-6 py-3.5 text-sm text-stone-500"><%= purchase.invoice_number.presence || "—" %></td>
              <td class="px-6 py-3.5 text-right text-sm font-bold text-stone-800">
                $<%= number_with_precision(purchase.total, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-center">
                <% case purchase.status
                   when "draft" %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-stone-100 text-stone-600">
                    <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span> Borrador
                  </span>
                <% when "received" %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Recibida
                  </span>
                <% when "cancelled" %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Cancelada
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-xs text-stone-400">
                <%= purchase.created_at.strftime("%d/%m/%Y") %>
              </td>
              <td class="px-6 py-3.5 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to "Ver", purchase_path(purchase), class: "text-xs text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
                  <% if purchase.draft? %>
                    <%= button_to "Recibir", receive_purchase_path(purchase), method: :patch,
                          class: "text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-3 py-1.5 rounded-lg transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-16 text-center">
        <p class="text-sm text-stone-400">No hay compras registradas aún.</p>
        <%= link_to "Registrar primera compra →", new_purchase_path, class: "mt-2 inline-block text-sm text-emerald-600 font-semibold" %>
      </div>
    <% end %>
  </div>

</div>
