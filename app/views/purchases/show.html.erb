<% content_for :page_title, "Compra ##{@purchase.id}" %>

<div class="space-y-5 max-w-3xl mx-auto">

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Orden de Compra</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @purchase.supplier.name %></p>
    </div>
    <%= link_to "← Volver", purchases_path, class: "text-sm text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <p class="text-xs text-stone-400 font-semibold uppercase tracking-wider">Proveedor</p>
        <p class="mt-1 font-medium text-stone-700"><%= @purchase.supplier.name %></p>
      </div>
      <div>
        <p class="text-xs text-stone-400 font-semibold uppercase tracking-wider">N° Factura</p>
        <p class="mt-1 font-medium text-stone-700"><%= @purchase.invoice_number.presence || "—" %></p>
      </div>
      <div>
        <p class="text-xs text-stone-400 font-semibold uppercase tracking-wider">Estado</p>
        <p class="mt-1 font-medium text-stone-700 capitalize"><%= @purchase.status %></p>
      </div>
      <div>
        <p class="text-xs text-stone-400 font-semibold uppercase tracking-wider">Total</p>
        <p class="mt-1 text-xl font-bold text-stone-800">$<%= number_with_precision(@purchase.total, precision: 2, delimiter: ",") %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50">
      <h3 class="text-sm font-bold text-stone-700">Productos</h3>
    </div>
    <table class="w-full">
      <thead>
        <tr class="border-b border-stone-50">
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Producto</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Cantidad</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Costo unitario</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Subtotal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-50">
        <% @purchase.purchase_items.each do |item| %>
          <tr>
            <td class="px-6 py-3.5 text-sm font-medium text-stone-700"><%= item.product.name %></td>
            <td class="px-6 py-3.5 text-right text-sm text-stone-600"><%= item.quantity %></td>
            <td class="px-6 py-3.5 text-right text-sm text-stone-600">$<%= number_with_precision(item.unit_cost, precision: 2) %></td>
            <td class="px-6 py-3.5 text-right text-sm font-bold text-stone-800">$<%= number_with_precision(item.quantity * item.unit_cost, precision: 2) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @purchase.draft? %>
    <div class="flex justify-end">
      <%= button_to "Confirmar recepción", receive_purchase_path(@purchase), method: :patch,
            class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm" %>
    </div>
  <% end %>

</div>
