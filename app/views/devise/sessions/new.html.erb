<!DOCTYPE html>
<html lang="es">
  <head>
    <title>RetailERP — Iniciar Sesión</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen flex bg-stone-50 antialiased font-sans">

    <%# ── Panel izquierdo (decorativo) ──────────────────────────── %>
    <div class="hidden lg:flex lg:w-1/2 flex-col justify-between p-10" style="background: #0f1f14;">

      <%# Logo %>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <span class="text-white font-bold text-xl tracking-tight">RetailERP</span>
      </div>

      <%# Stats decorativas %>
      <div class="space-y-4">
        <div class="space-y-2">
          <div class="flex items-center gap-3 bg-white/5 border border-white/8 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-stone-300">Gestión de Ventas</p>
              <p class="text-xs text-stone-600">Registra y controla tus ventas</p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-white/5 border border-white/8 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-teal-500/20 border border-teal-500/30 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-stone-300">Cartera de Clientes</p>
              <p class="text-xs text-stone-600">Administra fiados y deudas</p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-white/5 border border-white/8 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-stone-300">Control de Inventario</p>
              <p class="text-xs text-stone-600">Stock y productos en tiempo real</p>
            </div>
          </div>
        </div>
      </div>

      <%# Footer del panel %>
      <p class="text-xs text-stone-700">&copy; <%= Time.now.year %> RetailERP — Sistema de Gestión Minorista</p>
    </div>

    <%# ── Panel derecho (formulario) ────────────────────────────── %>
    <div class="flex-1 flex flex-col items-center justify-center px-6 py-12">

      <%# Logo móvil (solo visible en pantallas pequeñas) %>
      <div class="flex items-center gap-3 mb-10 lg:hidden">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <span class="font-bold text-xl text-stone-800 tracking-tight">RetailERP</span>
      </div>

      <div class="w-full max-w-sm">

        <%# Encabezado %>
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-stone-800">Bienvenido de nuevo</h1>
          <p class="text-sm text-stone-400 mt-1">Ingresa tus credenciales para continuar</p>
        </div>

        <%# Alertas de error %>
        <% if flash[:alert] %>
          <div class="mb-5 flex items-start gap-3 bg-rose-50 border border-rose-100 text-rose-700 rounded-xl px-4 py-3 text-sm">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%# Formulario %>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>

          <div>
            <%= f.label :email, "Correo electrónico",
                  class: "block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "tu@correo.com",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <div>
            <%= f.label :password, "Contraseña",
                  class: "block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  placeholder: "••••••••",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2">
              <%= f.check_box :remember_me,
                    class: "w-4 h-4 rounded border-stone-300 text-emerald-500 focus:ring-emerald-500/30 accent-emerald-500" %>
              <%= f.label :remember_me, "Recordarme",
                    class: "text-sm text-stone-500 select-none cursor-pointer" %>
            </div>
          <% end %>

          <%= f.submit "Iniciar sesión",
                class: "w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700
                        text-white text-sm font-semibold rounded-xl
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:ring-offset-2
                        transition-all duration-150 cursor-pointer mt-1" %>

        <% end %>

        <%# Links secundarios %>
        <div class="mt-6 flex flex-col items-center gap-3">
          <% if devise_mapping.recoverable? && controller.devise_controller? %>
            <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name),
                  class: "text-xs text-emerald-600 hover:text-emerald-700 font-medium transition-colors" %>
          <% end %>
        </div>

      </div>

      <%# Footer móvil %>
      <p class="mt-12 text-xs text-stone-300 lg:hidden">&copy; <%= Time.now.year %> RetailERP</p>
    </div>

  </body>
</html>
