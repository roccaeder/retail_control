<!DOCTYPE html>
<html lang="es">
  <head>
    <title>RetailERP — Crear cuenta</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen flex bg-stone-50 antialiased font-sans">

    <%# ── Panel izquierdo (decorativo) ──────────────────────────── %>
    <div class="hidden lg:flex lg:w-1/2 flex-col justify-between p-10" style="background: #0f1f14;">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <span class="text-white font-bold text-xl tracking-tight">RetailERP</span>
      </div>

      <div class="space-y-4">
        <p class="text-stone-300 text-sm leading-relaxed">
          Creá tu cuenta y empezá a gestionar ventas, clientes e inventario desde el primer día.
        </p>
        <div class="space-y-2">
          <div class="flex items-center gap-3 bg-white/5 border border-white/8 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <p class="text-xs text-stone-300">Registro gratuito, sin tarjeta de crédito</p>
          </div>
          <div class="flex items-center gap-3 bg-white/5 border border-white/8 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-teal-500/20 border border-teal-500/30 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <p class="text-xs text-stone-300">Tus datos aislados y seguros</p>
          </div>
        </div>
      </div>

      <p class="text-xs text-stone-700">&copy; <%= Time.now.year %> RetailERP — Sistema de Gestión Minorista</p>
    </div>

    <%# ── Panel derecho (formulario) ────────────────────────────── %>
    <div class="flex-1 flex flex-col items-center justify-center px-6 py-12">

      <div class="flex items-center gap-3 mb-10 lg:hidden">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <span class="font-bold text-xl text-stone-800 tracking-tight">RetailERP</span>
      </div>

      <div class="w-full max-w-sm">

        <div class="mb-8">
          <h1 class="text-2xl font-bold text-stone-800">Crear cuenta</h1>
          <p class="text-sm text-stone-400 mt-1">Completá los datos de tu negocio y de acceso</p>
        </div>

        <%# Errores %>
        <% if flash[:alert] %>
          <div class="mb-5 flex items-start gap-3 bg-rose-50 border border-rose-100 text-rose-700 rounded-xl px-4 py-3 text-sm">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if resource.errors.any? %>
          <div class="mb-5 bg-rose-50 border border-rose-100 text-rose-700 rounded-xl px-4 py-3 text-sm space-y-1">
            <% resource.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <%# Sección: datos del negocio %>
        <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-3">Tu negocio</p>

        <%= form_tag(user_registration_path, method: :post, class: "space-y-4") do %>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div>
            <label class="block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider">
              Nombre del negocio
            </label>
            <%= text_field_tag "account[name]",
                  @account&.name,
                  placeholder: "Ej: Almacén Don Pedro",
                  id: "account_name",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider">
              Subdominio
            </label>
            <div class="flex items-center rounded-xl border border-stone-200 bg-white overflow-hidden
                        focus-within:ring-2 focus-within:ring-emerald-500/30 focus-within:border-emerald-500 transition-all duration-150">
              <%= text_field_tag "account[subdomain]",
                    @account&.subdomain,
                    placeholder: "mi-almacen",
                    id: "account_subdomain",
                    class: "flex-1 px-4 py-2.5 bg-transparent text-sm text-stone-800
                            placeholder-stone-300 focus:outline-none" %>
              <span class="px-3 text-xs text-stone-400 bg-stone-50 border-l border-stone-200 py-2.5 shrink-0">
                .retailerp.app
              </span>
            </div>
            <p class="mt-1 text-xs text-stone-400">Solo letras minúsculas, números y guiones.</p>
          </div>

          <div class="border-t border-stone-100 pt-4">
            <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-3">Tu acceso</p>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider">
              Correo electrónico
            </label>
            <%= email_field_tag "user[email]",
                  resource.email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "tu@correo.com",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider">
              Contraseña
            </label>
            <%= password_field_tag "user[password]",
                  nil,
                  autocomplete: "new-password",
                  placeholder: "Mínimo 6 caracteres",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-600 mb-1.5 uppercase tracking-wider">
              Confirmar contraseña
            </label>
            <%= password_field_tag "user[password_confirmation]",
                  nil,
                  autocomplete: "new-password",
                  placeholder: "••••••••",
                  class: "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-sm text-stone-800
                          placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/30
                          focus:border-emerald-500 transition-all duration-150" %>
          </div>

          <%= submit_tag "Crear cuenta",
                class: "w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700
                        text-white text-sm font-semibold rounded-xl
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:ring-offset-2
                        transition-all duration-150 cursor-pointer mt-1" %>
        <% end %>

        <div class="mt-6 text-center">
          <%= link_to "¿Ya tenés cuenta? Iniciá sesión", new_user_session_path,
                class: "text-xs text-emerald-600 hover:text-emerald-700 font-medium transition-colors" %>
        </div>

      </div>

      <p class="mt-12 text-xs text-stone-300 lg:hidden">&copy; <%= Time.now.year %> RetailERP</p>
    </div>

    <%# Auto-slug: convierte el nombre del negocio al subdominio mientras el usuario escribe %>
    <script>
      const nameField = document.getElementById("account_name");
      const subdomainField = document.getElementById("account_subdomain");
      let userEditedSubdomain = false;

      subdomainField.addEventListener("input", () => { userEditedSubdomain = true; });

      nameField.addEventListener("input", () => {
        if (userEditedSubdomain) return;
        subdomainField.value = nameField.value
          .toLowerCase()
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\s-]/g, "")
          .trim()
          .replace(/\s+/g, "-");
      });
    </script>

  </body>
</html>
