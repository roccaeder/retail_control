<%= form_with model: supplier do |f| %>
  <% if supplier.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm space-y-1 mb-4">
      <% supplier.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div class="col-span-2">
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Nombre *</label>
        <%= f.text_field :name, class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400", placeholder: "Nombre del proveedor" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">RUC / NIT</label>
        <%= f.text_field :ruc_or_nit, class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Teléfono</label>
        <%= f.telephone_field :phone, class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>
      <div class="col-span-2">
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Email</label>
        <%= f.email_field :email, class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-3 mt-4">
    <%= link_to "Cancelar", suppliers_path, class: "px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-stone-800 transition-colors", data: { turbo_frame: "_top" } %>
    <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
