<% content_for :page_title, @supplier.name %>

<div class="max-w-2xl mx-auto space-y-5">

  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-stone-800"><%= @supplier.name %></h1>
    <div class="flex items-center gap-3">
      <%= link_to "Editar", edit_supplier_path(@supplier),
            class: "text-sm text-stone-500 hover:text-stone-700 font-medium",
            data: { turbo_frame: "_top" } %>
      <%= link_to "← Volver", suppliers_path,
            class: "text-sm text-stone-500 hover:text-stone-700 font-medium",
            data: { turbo_frame: "_top" } %>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6">
    <dl class="grid grid-cols-2 gap-x-8 gap-y-4 text-sm">
      <div>
        <dt class="text-xs font-semibold text-stone-400 uppercase tracking-wider">RUC / NIT</dt>
        <dd class="mt-1 text-stone-700"><%= @supplier.ruc_or_nit.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Teléfono</dt>
        <dd class="mt-1 text-stone-700"><%= @supplier.phone.presence || "—" %></dd>
      </div>
      <div class="col-span-2">
        <dt class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Email</dt>
        <dd class="mt-1 text-stone-700"><%= @supplier.email.presence || "—" %></dd>
      </div>
    </dl>
  </div>

</div>
