<% content_for :page_title, "Revisar Coincidencias" %>

<div class="space-y-5 max-w-5xl mx-auto">

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Revisar Coincidencias</h1>
      <p class="text-sm text-stone-400 mt-0.5">
        <%= @supplier_import.supplier.name %> · <%= @resolutions.count %> filas por revisar
      </p>
    </div>
    <%= link_to "← Volver", supplier_import_path(@supplier_import), class: "text-sm text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
  </div>

  <% if @resolutions.any? %>
    <div class="space-y-3">
      <% @resolutions.each do |resolution| %>
        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Texto del proveedor</p>
              <p class="text-sm font-medium text-stone-800 mt-0.5"><%= resolution.raw_name %></p>
            </div>

            <% if resolution.candidates.any? %>
              <div class="flex flex-wrap gap-1.5">
                <% resolution.candidates.each do |c| %>
                  <% product = @products_by_id[c["product_id"]] %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-stone-50 text-stone-600 border border-stone-100">
                    <%= product&.name || "producto eliminado" %>
                    <span class="text-stone-400">· <%= (c["score"].to_f * 100).round %>% · <%= c["strategy"] %></span>
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="text-xs text-stone-400">Sin candidatos sugeridos.</p>
            <% end %>
          </div>

          <div class="mt-4 flex items-center gap-2">
            <%= form_with url: supplier_import_resolution_path(@supplier_import, resolution), method: :patch, class: "flex items-center gap-2 flex-1" do %>
              <select name="product_id" class="flex-1 rounded-xl border border-stone-200 px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                <option value="">Seleccionar producto…</option>
                <% if resolution.candidates.any? %>
                  <optgroup label="Sugeridos">
                    <% resolution.candidates.each do |c| %>
                      <% product = @products_by_id[c["product_id"]] %>
                      <% next unless product %>
                      <option value="<%= product.id %>"><%= product.name %> (<%= (c["score"].to_f * 100).round %>%)</option>
                    <% end %>
                  </optgroup>
                <% end %>
                <optgroup label="Todos los productos">
                  <% @all_products.each do |product| %>
                    <option value="<%= product.id %>"><%= product.name %></option>
                  <% end %>
                </optgroup>
              </select>
              <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm cursor-pointer whitespace-nowrap">
                Confirmar
              </button>
            <% end %>

            <%= button_to "Descartar", supplier_import_resolution_path(@supplier_import, resolution),
                  method: :patch, params: { reject: true },
                  class: "text-sm font-medium text-rose-500 hover:text-rose-700 px-3 py-2 whitespace-nowrap cursor-pointer",
                  data: { turbo_confirm: "¿Marcar esta fila como sin coincidencia?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm py-16 text-center">
      <p class="text-sm text-stone-400">No hay filas pendientes de revisión.</p>
    </div>
  <% end %>

</div>
