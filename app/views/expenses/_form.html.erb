<%= form_with model: expense do |f| %>
  <% if expense.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm space-y-1 mb-4">
      <% expense.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4">

      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Categoría *</label>
        <%= f.select :category,
              options_for_select(categories, expense.category),
              { include_blank: "Seleccionar…" },
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-400" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Monto *</label>
        <%= f.number_field :amount, min: 0.01, step: "0.01",
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-400",
              placeholder: "0.00" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Fecha *</label>
        <%= f.date_field :date,
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-400" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Proveedor</label>
        <%= f.select :supplier_id,
              options_from_collection_for_select(suppliers, :id, :name, expense.supplier_id),
              { include_blank: "Ninguno" },
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-400" %>
      </div>

      <div class="col-span-2">
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Descripción</label>
        <%= f.text_area :description, rows: 2,
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-400 resize-none",
              placeholder: "Detalle opcional del gasto…" %>
      </div>

    </div>
  </div>

  <div class="flex justify-end gap-3 mt-4">
    <%= link_to "Cancelar", expenses_path,
          class: "px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-stone-800 transition-colors",
          data: { turbo_frame: "_top" } %>
    <%= f.submit "Registrar Gasto",
          class: "bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
