<% content_for :page_title, "Nueva Importación de Proveedor" %>

<div class="max-w-2xl mx-auto space-y-5">

  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-stone-800">Nueva Importación de Proveedor</h1>
    <%= link_to "← Volver", supplier_imports_path, class: "text-sm text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
  </div>

  <%= form_with model: @supplier_import, url: supplier_imports_path, data: { turbo: false } do |f| %>
    <% if @supplier_import.errors.any? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm space-y-1 mb-4">
        <% @supplier_import.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Proveedor *</label>
        <%= f.select :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, @supplier_import.supplier_id),
              { include_blank: "Seleccionar…" },
              class: "w-full rounded-xl border border-stone-200 px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Lista de precios (CSV) *</label>
        <%= f.file_field :file, accept: ".csv,text/csv",
              class: "w-full text-sm text-stone-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" %>
        <p class="mt-1.5 text-xs text-stone-400">
          Debe tener una columna con el nombre del producto (nombre, name, producto, product, descripcion o description).
        </p>
      </div>
    </div>

    <div class="flex justify-end gap-3 mt-4">
      <%= link_to "Cancelar", supplier_imports_path, class: "px-4 py-2.5 text-sm font-medium text-stone-600 hover:text-stone-800 transition-colors", data: { turbo_frame: "_top" } %>
      <%= f.submit "Subir y procesar", class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer" %>
    </div>
  <% end %>

</div>
