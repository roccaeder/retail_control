<% content_for :page_title, "Importación — #{@supplier_import.supplier.name}" %>

<% if @supplier_import.pending? || @supplier_import.processing? %>
  <meta http-equiv="refresh" content="2">
<% end %>

<div class="max-w-2xl mx-auto space-y-5">

  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-stone-800"><%= @supplier_import.supplier.name %></h1>
    <%= link_to "← Volver", supplier_imports_path, class: "text-sm text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-6 space-y-5">
    <div class="flex items-center justify-between">
      <dt class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</dt>
      <%= render "status_badge", supplier_import: @supplier_import %>
    </div>

    <% if @supplier_import.failed? && @supplier_import.error_message.present? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm">
        <%= @supplier_import.error_message %>
      </div>
    <% end %>

    <% if @supplier_import.pending? || @supplier_import.processing? %>
      <p class="text-sm text-stone-400">Procesando el archivo… esta página se actualiza sola.</p>
    <% end %>

    <% if @supplier_import.completed? %>
      <dl class="grid grid-cols-3 gap-4 text-center">
        <div class="bg-stone-50 rounded-xl py-4">
          <dt class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Filas</dt>
          <dd class="mt-1 text-xl font-bold text-stone-800"><%= @supplier_import.total_rows %></dd>
        </div>
        <div class="bg-emerald-50 rounded-xl py-4">
          <dt class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Auto-match</dt>
          <dd class="mt-1 text-xl font-bold text-emerald-700"><%= @supplier_import.auto_matched_count %></dd>
        </div>
        <div class="bg-amber-50 rounded-xl py-4">
          <dt class="text-xs font-semibold text-amber-600 uppercase tracking-wider">Por revisar</dt>
          <dd class="mt-1 text-xl font-bold text-amber-700"><%= @supplier_import.needs_review_count %></dd>
        </div>
      </dl>
    <% end %>
  </div>

</div>
