<% content_for :page_title, "Importaciones de Proveedores" %>

<div class="space-y-5 max-w-6xl mx-auto">

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Importaciones de Proveedores</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @supplier_imports.count %> importaciones registradas</p>
    </div>
    <%= link_to new_supplier_import_path, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
      </svg>
      Nueva Importación
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <% if @supplier_imports.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-100">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Proveedor</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Filas</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Auto-match</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Por revisar</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Fecha</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @supplier_imports.each do |supplier_import| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3.5 text-sm font-medium text-stone-700"><%= supplier_import.supplier.name %></td>
              <td class="px-6 py-3.5 text-center"><%= render "status_badge", supplier_import: %></td>
              <td class="px-6 py-3.5 text-right text-sm text-stone-600"><%= supplier_import.total_rows %></td>
              <td class="px-6 py-3.5 text-right text-sm text-stone-600"><%= supplier_import.auto_matched_count %></td>
              <td class="px-6 py-3.5 text-right text-sm font-semibold text-amber-600"><%= supplier_import.needs_review_count %></td>
              <td class="px-6 py-3.5 text-xs text-stone-400"><%= supplier_import.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="px-6 py-3.5 text-right">
                <%= link_to "Ver", supplier_import_path(supplier_import), class: "text-xs text-stone-500 hover:text-stone-700 font-medium", data: { turbo_frame: "_top" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-16 text-center">
        <p class="text-sm text-stone-400">No hay importaciones registradas aún.</p>
        <%= link_to "Subir la primera lista de precios →", new_supplier_import_path, class: "mt-2 inline-block text-sm text-emerald-600 font-semibold" %>
      </div>
    <% end %>
  </div>

</div>
