<% content_for :page_title, "Inventario" %>

<div class="space-y-5 max-w-7xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Inventario</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @products.count %> productos en catálogo</p>
    </div>
    <%= link_to new_product_path, class: "inline-flex items-center gap-2 bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
      </svg>
      Nuevo Producto
    <% end %>
  </div>

  <%# ── KPI mini-cards ─────────────────────────────────────── %>
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Productos</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-800"><%= Product.count %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Stock Bajo (&lt;10)</p>
      <p class="mt-1.5 text-2xl font-bold text-rose-600"><%= Product.where("stock < ?", 10).count %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Sin Stock</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-500"><%= Product.where(stock: 0).count %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Valor Inventario</p>
      <p class="mt-1.5 text-2xl font-bold text-violet-600">
        $<%= number_with_precision(Product.sum("stock * cost_price"), precision: 0, delimiter: ",") %>
      </p>
    </div>
  </div>

  <%= turbo_frame_tag "products-list", data: { turbo_action: "advance" } do %>

  <%# ── Buscador ────────────────────────────────────────────── %>
  <%= form_with url: products_path, method: :get, data: { controller: "search", turbo_frame: "products-list" } do |f| %>
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
      </svg>
      <%= f.search_field :q, value: params[:q],
            placeholder: "Buscar por nombre o SKU…",
            autocomplete: "off",
            data: { action: "input->search#search" },
            class: "w-full pl-9 pr-4 py-2.5 rounded-xl border border-stone-200 text-sm text-stone-800 placeholder-stone-300 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent bg-white shadow-sm" %>
    </div>
  <% end %>

  <%# ── Tabla ──────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50">
      <h3 class="text-sm font-bold text-stone-700">Catálogo de Productos</h3>
    </div>

    <% if @products.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Producto</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">SKU</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Stock</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Costo</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Precio Venta</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Margen</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @products.each do |product| %>
            <% margin = product.cost_price > 0 ? ((product.sale_price - product.cost_price) / product.cost_price * 100).round(1) : 0 %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-violet-50 border border-violet-100 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  </div>
                  <span class="text-sm font-semibold text-stone-700"><%= product.name %></span>
                </div>
              </td>
              <td class="px-6 py-3.5 text-xs font-mono text-stone-500 bg-stone-50/50">
                <%= product.sku.presence || "—" %>
              </td>
              <td class="px-6 py-3.5 text-center">
                <span class="text-sm font-bold <%= product.stock.to_i == 0 ? 'text-stone-400' : product.stock.to_i < 10 ? 'text-rose-600' : 'text-stone-700' %>">
                  <%= product.stock %>
                </span>
              </td>
              <td class="px-6 py-3.5 text-right text-sm text-stone-500">
                $<%= number_with_precision(product.cost_price, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-right text-sm font-semibold text-stone-800">
                $<%= number_with_precision(product.sale_price, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-right text-sm font-semibold <%= margin >= 20 ? 'text-emerald-600' : margin >= 5 ? 'text-amber-600' : 'text-rose-500' %>">
                <%= margin %>%
              </td>
              <td class="px-6 py-3.5 text-center">
                <% if product.stock.to_i == 0 %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-stone-100 text-stone-500">
                    <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span> Sin stock
                  </span>
                <% elsif product.stock.to_i < 10 %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Stock bajo
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Disponible
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-right">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to edit_product_path(product), class: "text-xs font-semibold text-stone-400 hover:text-violet-600 transition-colors" do %>
                    Editar
                  <% end %>
                  <%= button_to product_path(product), method: :delete,
                        data: { turbo_confirm: "¿Eliminar #{product.name}? Esta acción no se puede deshacer." },
                        class: "text-xs font-semibold text-stone-400 hover:text-rose-600 transition-colors bg-transparent border-0 cursor-pointer p-0" do %>
                    Eliminar
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-20 text-center">
        <div class="w-14 h-14 bg-stone-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <p class="text-sm font-semibold text-stone-500">Sin productos en inventario</p>
        <p class="text-xs text-stone-400 mt-1">Agrega tu primer producto para empezar</p>
        <%= link_to "Agregar producto", new_product_path, class: "mt-4 inline-flex items-center gap-1.5 text-sm text-violet-600 hover:text-violet-700 font-semibold" %>
      </div>
    <% end %>
  </div>

  <%# ── Paginación ─────────────────────────────────────────── %>
  <% if @pagy.pages > 1 %>
    <div class="flex justify-center">
      <%== pagy_tailwind_nav(@pagy) %>
    </div>
  <% end %>

  <% end %> <%# turbo_frame %>

</div>
