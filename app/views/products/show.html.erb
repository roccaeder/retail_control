<% content_for :page_title, @product.name %>

<% margin = @product.cost_price > 0 ? ((@product.sale_price - @product.cost_price) / @product.cost_price * 100).round(1) : 0 %>

<div class="space-y-5 max-w-3xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800"><%= @product.name %></h1>
      <p class="text-sm text-stone-400 mt-0.5 font-mono"><%= @product.sku.presence || "Sin SKU" %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to edit_product_path(@product),
            class: "inline-flex items-center gap-2 bg-white hover:bg-stone-50 border border-stone-200 text-stone-700 text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Editar
      <% end %>
      <%= link_to products_path, class: "text-sm text-stone-500 hover:text-stone-700 font-semibold px-2 py-2 transition-colors" do %>
        ← Volver
      <% end %>
    </div>
  </div>

  <%# ── Cards de métricas ───────────────────────────────────── %>
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Stock</p>
      <p class="mt-1.5 text-2xl font-bold <%= @product.stock.to_i == 0 ? 'text-stone-400' : @product.stock.to_i < 10 ? 'text-rose-600' : 'text-stone-800' %>">
        <%= @product.stock %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Precio de venta</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-800">$<%= number_with_precision(@product.sale_price, precision: 2, delimiter: ",") %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Costo</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-500">$<%= number_with_precision(@product.cost_price, precision: 2, delimiter: ",") %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Margen</p>
      <p class="mt-1.5 text-2xl font-bold <%= margin >= 20 ? 'text-emerald-600' : margin >= 5 ? 'text-amber-600' : 'text-rose-500' %>">
        <%= margin %>%
      </p>
    </div>
  </div>

  <%# ── Detalle ─────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50">
      <h3 class="text-sm font-bold text-stone-700">Detalle del producto</h3>
    </div>
    <dl class="divide-y divide-stone-50">
      <div class="px-6 py-3.5 flex justify-between items-center">
        <dt class="text-sm text-stone-500">Nombre</dt>
        <dd class="text-sm font-semibold text-stone-800"><%= @product.name %></dd>
      </div>
      <div class="px-6 py-3.5 flex justify-between items-center">
        <dt class="text-sm text-stone-500">SKU</dt>
        <dd class="text-sm font-mono text-stone-600"><%= @product.sku.presence || "—" %></dd>
      </div>
      <div class="px-6 py-3.5 flex justify-between items-center">
        <dt class="text-sm text-stone-500">Estado</dt>
        <dd>
          <% if @product.stock.to_i == 0 %>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-stone-100 text-stone-500">
              <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span> Sin stock
            </span>
          <% elsif @product.stock.to_i < 10 %>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Stock bajo
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Disponible
            </span>
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-3.5 flex justify-between items-center">
        <dt class="text-sm text-stone-500">Creado</dt>
        <dd class="text-sm text-stone-600"><%= l @product.created_at, format: :long %></dd>
      </div>
    </dl>
  </div>

</div>
