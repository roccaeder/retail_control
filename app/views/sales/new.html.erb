<% content_for :page_title, "Nueva Venta" %>

<div class="space-y-5 max-w-7xl mx-auto">
  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Nueva Venta</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @products.count %> productos en stock</p>
    </div>
  </div>

  <%= form_with(model: @sale, data: { controller: "sale-items" }) do |f| %>
    <div class="space-y-5">
      <% if @sale.errors.any? %>
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-4 text-sm text-rose-700">
          <p class="font-semibold mb-1">No se pudo guardar la venta:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @sale.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# ── CLIENTE ──────────────────────────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm transition-all"
          data-sale-items-target="customerSection">
        <div class="flex items-center gap-2 mb-2">
          <%= f.label :customer_id, "Cliente", class: "text-sm font-semibold text-stone-700" %>
          <span data-sale-items-target="customerRequired"
                class="hidden text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">
            Requerido para A Crédito
          </span>
        </div>
        <%= f.collection_select :customer_id, @customers, :id, :name,
            { prompt: "Seleccionar cliente..." },
            { class: "w-full border border-stone-200 rounded-xl px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400",
              data: { sale_items_target: "customerSelect" } } %>
      </div>

      <%# ── SELECCIÓN DE PRODUCTO ───────────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm flex items-end gap-3">
        <div class="flex-1">
          <label class="text-sm font-semibold text-stone-700 block mb-1">Producto</label>
          <select id="product-picker" data-sale-items-target="productSelect"
                  class="w-full border border-stone-200 rounded-xl px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400">
            <option value="">Buscar producto...</option>
            <% @products.each do |p| %>
              <option value="<%= p.id %>" data-price="<%= p.sale_price %>" data-name="<%= p.name %>">
                <%= p.name %> — $<%= p.sale_price %>
              </option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="text-sm font-semibold text-stone-700 block mb-1">Unidades</label>
          <input type="number" id="units" value="1" min="1"
                data-sale-items-target="quantityInput"
                class="w-20 border border-stone-200 rounded-xl px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400">
        </div>

        <button type="button" data-action="click->sale-items#add"
                class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm">
          Agregar
        </button>
      </div>

      <%# ── TABLA DE PRODUCTOS ──────────────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-stone-50">
              <th class="px-4 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Producto</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Cant.</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Precio</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Total</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody data-sale-items-target="tableBody" class="divide-y divide-stone-50">
          </tbody>
        </table>
      </div>

      <%# ── TOTALES ─────────────────────────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
        <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
          <div>
            <%= f.label :subtotal, "Subtotal", class: "text-xs font-semibold text-stone-400 uppercase tracking-wider block mb-1" %>
            <%= f.number_field :subtotal, step: :any, value: 0, readonly: true,
                class: "w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-sm text-stone-600",
                data: { sale_items_target: "subtotalInput" } %>
          </div>

          <div>
            <%= f.label :discount_amount, "Descuento", class: "text-xs font-semibold text-stone-400 uppercase tracking-wider block mb-1" %>
            <%= f.number_field :discount_amount, step: :any, value: 0,
                class: "w-full border border-stone-200 rounded-xl px-3 py-2 text-sm text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-400",
                data: {
                  sale_items_target: "discountInput",
                  action: "input->sale-items#calculateTotals"
                } %>
          </div>

          <div>
            <label class="text-xs font-semibold text-stone-400 uppercase tracking-wider block mb-1">Monto Recibido</label>
            <input type="number" step="any" value="0" readonly
                  data-sale-items-target="totalInput"
                  data-action="input->sale-items#calculateDebt"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-sm transition-all">
          </div>

          <div>
            <label class="text-xs font-semibold text-stone-400 uppercase tracking-wider block mb-1">Deuda</label>
            <input type="number" step="any" value="0" readonly
                  data-sale-items-target="debtInput"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-3 py-2 text-sm text-rose-600 font-bold">
          </div>
        </div>
      </div>

      <%# ── MÉTODO DE PAGO + A CRÉDITO ─────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm space-y-5">

        <%# Método de pago -%>
        <div>
          <span class="block text-sm font-semibold text-stone-700 mb-3">Método de Pago</span>
          <div class="grid grid-cols-2 gap-3">
            <% [["Efectivo", "cash"], ["Transferencia", "transfer"]].each do |label, value| %>
              <label class="cursor-pointer">
                <%= f.radio_button :payment_method, value,
                    checked: value == "cash",
                    class: "peer hidden" %>
                <div class="flex items-center justify-center p-3 border-2 border-stone-100 rounded-xl text-sm font-medium text-stone-600 transition-all
                            peer-checked:border-emerald-600 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 hover:bg-stone-50">
                  <%= label %>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# A Crédito toggle -%>
        <div class="border-t border-stone-50 pt-4">
          <span class="block text-sm font-semibold text-stone-700 mb-3">¿A Crédito?</span>
          <label class="cursor-pointer">
            <%= f.check_box :on_credit,
                { class: "peer hidden",
                  data: { action: "change->sale-items#toggleCredit" } },
                "1", "0" %>
            <div class="flex items-center justify-between p-3 border-2 border-stone-100 rounded-xl transition-all
                        peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:bg-stone-50">
              <div>
                <p class="text-sm font-semibold text-stone-600">A Crédito</p>
                <p class="text-xs text-stone-400">El cliente paga parcial o en otro momento</p>
              </div>
            </div>
          </label>
        </div>

      </div>

      <%# ── ACCIONES ─────────────────────────────────────────── %>
      <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm flex items-center gap-2">
        <%= f.submit "Registrar Venta",
            class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" %>
        <%= link_to "Cancelar", sales_path,
            class: "inline-flex items-center text-sm font-semibold px-4 py-2 rounded-xl bg-stone-100 text-stone-700 hover:bg-stone-200 transition-colors border border-stone-200" %>
      </div>

      <template data-sale-items-target="itemTemplate">
        <tr class="hover:bg-stone-50/60 transition-colors">
          <td class="px-4 py-3">
            <span data-label="name" class="font-medium text-stone-700"></span>
            <input type="hidden" name="sale[sale_items_attributes][NEW_ID][product_id]" data-label="productId">
            <input type="hidden" name="sale[sale_items_attributes][NEW_ID][unit_price]" data-label="unitPrice">
          </td>
          <td class="px-4 py-3 text-center">
            <input type="number" name="sale[sale_items_attributes][NEW_ID][quantity]" data-label="quantity" readonly
                  class="w-14 text-center bg-stone-50 border border-stone-100 rounded-lg text-sm py-1">
          </td>
          <td class="px-4 py-3 text-right text-stone-500"><span data-label="price"></span></td>
          <td class="px-4 py-3 text-right font-semibold text-stone-700"><span data-label="subtotal"></span></td>
          <td class="px-4 py-3 text-center">
            <button type="button" data-action="click->sale-items#remove"
                    class="text-rose-400 hover:text-rose-600 font-bold text-2xl leading-none transition-colors w-8 h-8 flex items-center justify-center rounded-lg hover:bg-rose-50">×</button>
          </td>
        </tr>
      </template>
    </div>
  <% end %>
</div>
