<% content_for :page_title, "Ventas" %>

<div class="space-y-5 max-w-7xl mx-auto">

  <%# ── Header ─────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-stone-800">Ventas</h1>
      <p class="text-sm text-stone-400 mt-0.5"><%= @sales.count %> transacciones en total</p>
    </div>
    <%= link_to new_sale_path, class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
      </svg>
      Nueva Venta
    <% end %>
  </div>

  <div data-controller="hello">
    <input type="text" data-hello-target="name">
    <button data-action="click->hello#greet">Saludar</button>
  </div>

  <%# ── KPI mini-cards ─────────────────────────────────────── %>
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Total Recaudado</p>
      <p class="mt-1.5 text-2xl font-bold text-emerald-600">
        $<%= number_with_precision(@sales.sum(:total), precision: 2, delimiter: ",") %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Ventas Hoy</p>
      <p class="mt-1.5 text-2xl font-bold text-teal-600">
        $<%= number_with_precision(Sale.where(created_at: Time.zone.today.all_day).sum(:total), precision: 2, delimiter: ",") %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Pagadas</p>
      <p class="mt-1.5 text-2xl font-bold text-stone-800">
        <%= @sales.where(status: :paid).count %>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm">
      <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider">Pendientes</p>
      <p class="mt-1.5 text-2xl font-bold text-amber-600">
        <%= @sales.where(status: :pending).count %>
      </p>
    </div>
  </div>

  <%# ── Filters row ─────────────────────────────────────────── %>
  <div class="flex items-center gap-2">
    <span class="text-xs text-stone-400 font-medium">Filtrar:</span>
    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-stone-900 text-white">Todas</button>
    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-stone-200 text-stone-500 hover:border-emerald-300 hover:text-emerald-700 transition-colors">Pagadas</button>
    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-stone-200 text-stone-500 hover:border-amber-300 hover:text-amber-700 transition-colors">Pendientes</button>
    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-stone-200 text-stone-500 hover:border-teal-300 hover:text-teal-700 transition-colors">Hoy</button>
  </div>

  <%# ── Table ──────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-50">
      <h3 class="text-sm font-bold text-stone-700">Historial de Ventas</h3>
    </div>

    <% if @sales.any? %>
      <table class="w-full">
        <thead>
          <tr class="border-b border-stone-50">
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">#</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Cliente</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Subtotal</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Descuento</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-400 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Método</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-stone-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-400 uppercase tracking-wider">Fecha</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-50">
          <% @sales.each do |sale| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-6 py-3.5 text-xs font-mono text-stone-400">#<%= sale.id %></td>
              <td class="px-6 py-3.5">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-700 text-xs font-bold shrink-0">
                    <%= sale.customer.name[0].upcase %>
                  </div>
                  <span class="text-sm font-medium text-stone-700"><%= sale.customer.name %></span>
                </div>
              </td>
              <td class="px-6 py-3.5 text-right text-sm text-stone-500">
                $<%= number_with_precision(sale.subtotal, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-right text-sm">
                <% if sale.discount_amount > 0 %>
                  <span class="text-rose-500 font-medium">-$<%= number_with_precision(sale.discount_amount, precision: 2, delimiter: ",") %></span>
                <% else %>
                  <span class="text-stone-300">—</span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-right text-sm font-bold text-stone-800">
                $<%= number_with_precision(sale.total, precision: 2, delimiter: ",") %>
              </td>
              <td class="px-6 py-3.5 text-center">
                <% if sale.payment_method == "cash" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-600">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                    </svg>
                    Efectivo
                  </span>
                <% elsif sale.payment_method == "credit" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                    Fiado
                  </span>
                <% elsif sale.payment_method == "transfer" %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-teal-50 text-teal-700">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                    </svg>
                    Transferencia
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-center">
                <% if sale.paid? %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Pagado
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Pendiente
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-xs text-stone-400">
                <%= sale.created_at.strftime("%d/%m/%Y") %>
                <span class="block text-stone-300"><%= sale.created_at.strftime("%H:%M") %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-20 text-center">
        <div class="w-14 h-14 bg-stone-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-sm font-semibold text-stone-500">No hay ventas registradas</p>
        <p class="text-xs text-stone-400 mt-1">Registra tu primera venta para comenzar</p>
        <%= link_to "Registrar venta", new_sale_path, class: "mt-4 inline-flex items-center gap-1.5 text-sm text-emerald-600 hover:text-emerald-700 font-semibold" %>
      </div>
    <% end %>
  </div>

</div>
