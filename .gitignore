# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# --- Rails 8 Core ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Database (Postgres en Docker no necesita ignorar .sqlite3, pero es buena práctica)
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*

# --- Seguridad (CRÍTICO) ---
# Nunca subas tus llaves maestras ni credenciales
config/master.key
config/credentials/*.key
.env
.env*.local

# --- Assets & JavaScript ---
# Ignora los archivos compilados por Tailwind/Propshaft
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
node_modules/
.bundle/

# --- Storage (Fotos/Archivos subidos) ---
/storage/*
!/storage/.keep
/public/uploads

# --- Docker ---
# Ignora archivos de estado de Docker si los hay
.docker-sync/
docker-compose.override.yml

# --- Sistema y Editores ---
.DS_Store
.vscode/
.idea/
*.swp
*.orig